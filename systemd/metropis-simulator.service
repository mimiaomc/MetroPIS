[Unit]
Description=Metro ATS Signaling Simulation Engine
After=metropis-server.service
Wants=metropis-server.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/MetroPIS
ExecStart=/usr/bin/python3 simulator.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
